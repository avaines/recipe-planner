rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /allow-users/{userId} {
      allow read, write: if request.auth.uid == userId;
    }

    function isSignedIn() {
      return request.auth.uid != null;
    }

    function isAllowedUser() {
      let userDoc = get(/databases/$(database)/documents/allow-users/$(request.auth.uid));
      return userDoc != null && userDoc.data.enabled == true;
    }

    function getGroupId() {
      let userDoc = get(/databases/$(database)/documents/allow-users/$(request.auth.uid));
      return userDoc != null ? userDoc.data.groupId : null;
    }

    match /{document=**} {
      allow list: if isSignedIn() && getGroupId() != null;
    }

    match /{recipesGroupId}/{document=**} {
      allow create, read, write, delete: if isSignedIn() && isAllowedUser() && ("recipes-" + getGroupId()) == recipesGroupId
    }

    match /{instructionsGroupId}/{document=**} {
      allow create, read, write, delete: if isSignedIn() && isAllowedUser() && ("recipe-instructions-" + getGroupId()) == instructionsGroupId
    }

    match /{menusGroupId}/{menuDocId} {
      // Public read access is limited to the single saved-menu document for UUID-style group collections.
      allow get: if menusGroupId.matches('^menus-[0-9a-fA-F-]{36}$') && menuDocId == 'current';
      allow list: if false;
      allow create, write, delete: if isSignedIn() && isAllowedUser() && ("menus-" + getGroupId()) == menusGroupId;
    }
  }
}
